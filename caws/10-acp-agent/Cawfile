# 10 - ACP Agent Protocol
#
# Demonstrates how to use an external agent via the Agent Client Protocol (ACP).
# ACP agents communicate via JSON-RPC over stdio.
#
# Usage:
#   exec "codex-acp", runtime: {"acp" => true}
#   exec "claude-code-acp", runtime: {"acp" => true}
#
# This workflow also exposes itself as an ACP agent via Api::ACP::Agent

settings do
  data.adapter = "memory"
  port = 4111
end

container do
  packages = ["codex-acp"]
  files = ["."]
end

struct Input
  include Api::Federation::Inbox
  include Api::ACP::Agent
end

struct Output
  include Api::Federation::Outbox
  include Api::ACP::Agent
end

@[Validate(Input, Output)]
workflow "10-acp-agent" do
  exec "codex-acp", runtime: {"acp" => true}
end
